{
  "name": "couperconf",
  "displayName": "Couper Configuration",
  "version": "1.10.1",
  "publisher": "couper",
  "description": "Provides autocompletion, syntax/semantic validation and syntax highlighting for Couper's HCL based configuration file.",
  "keywords": [
    "couper.hcl",
    "couper",
    "couper.io",
    "hcl"
  ],
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "icon": "images/couper_logo.png",
  "galleryBanner": {
    "color": "#ffffff",
    "theme": "light"
  },
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=22"
  },
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "build:schema": "node scripts/merge-schema.js",
    "check:schema": "node scripts/schema-drift.js",
    "sync:schema": "node scripts/schema-drift.js --fix && node scripts/merge-schema.js",
    "lint": "eslint",
    "package": "vsce package",
    "test": "jest --verbose"
  },
  "contributes": {
    "languages": [
      {
        "id": "couper",
        "aliases": [
          "Couper"
        ],
        "extensions": [
          ".hcl",
          ".couper"
        ],
        "icon": {
          "light": "./images/couper_icon.png",
          "dark": "./images/couper_icon.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "couper",
        "scopeName": "source.hcl",
        "path": "./syntaxes/hcl.json"
      }
    ]
  },
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/vscode": "~1.101.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.0",
    "globals": "^17.13.0",
    "jest": "^30.0.0",
    "ovsx": "^1.2.0"
  },
  "bugs": "https://github.com/coupergateway/couper-vscode/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/coupergateway/couper-vscode"
  },
  "homepage": "https://github.com/coupergateway/couper",
  "license": "MIT"
}
